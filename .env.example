# Copy to .env or .env.test.local (see docs/TEST_ENVIRONMENT.md)
# Get URL + anon key from Supabase → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key

# Must match a row in public.tenants.slug (default for localhost / reserved hosts)
# VITE_DEFAULT_TENANT_SLUG=lakecity

# Optional scheduled-maintenance overlay (MaintenanceGate is a no-op in production UI)
# VITE_SCHEDULED_MAINTENANCE=false

# --- One-off Supabase → Odoo BNPL migration (scripts/migrate-supabase-to-odoo-bnpl.mjs) ---
# Copy these into your local .env only; never commit real values.
# SUPABASE_URL should match your project (same host as VITE_SUPABASE_URL, without VITE_ prefix).
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API → service_role (secret).
# ODOO_ORIGIN: production URL only, e.g. https://yourcompany.odoo.com  (no trailing slash)
# LAKECITY_LOAN_API_TOKEN: must equal Odoo → Settings → Technical → Parameters → lakecity_loan.api_token
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# ODOO_ORIGIN=https://YOUR_INSTANCE.odoo.com
# LAKECITY_LOAN_API_TOKEN=your_same_token_as_odoo
# TENANT_SLUG=lakecity
# DRY_RUN=1
# SKIP_PREFLIGHT=1
# CLI: --dry-run | --preflight-only | --skip-preflight
# Optional: retries on transient Odoo errors (post first try + retries; default 4).
# MIGRATE_ODOO_RETRIES=4
# CREATE_CRM_LEAD_FIRST=1   # create CRM lead before partner + loan (requires lakecity_loan_management ≥ 19.0.1.0.4)
#
# --- Stand inventory → Odoo product sync (Edge Function sync-stand-odoo-product) ---
# Set as Supabase Edge Function secrets (same values as migration uses for Odoo):
# ODOO_ORIGIN=https://YOUR_INSTANCE.odoo.com
# LAKECITY_LOAN_API_TOKEN=your_same_token_as_odoo
# In Supabase Dashboard → Database → Replication, add public.stand_inventory for Realtime if you want the grid to refresh when another user edits.

# --- Smoke-test Make receipt webhook (scripts/test-make-receipt-webhook.mjs) ---
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/bhoso4zsfmneuo8dojja63igi6arxrxs
