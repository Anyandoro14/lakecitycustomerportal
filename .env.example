# Copy to .env.local (browser) / supabase/functions/.env (edge functions). NEVER commit real values.
# Leave the Supabase values empty to run the whole flow against the in-browser mock backend.

# --- Browser (Vite) --------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PORTAL_URL=https://lakecity.standledger.io
# Public origin of this app (offer links in email previews). Defaults to the browser origin.
VITE_APP_URL=
# Same value as DOCUSIGN_INTEGRATION_KEY (public client id, needed by the Focused View JS)
VITE_DOCUSIGN_INTEGRATION_KEY=

# --- Edge functions (supabase secrets set --env-file supabase/functions/.env) ---------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# DocuSign DEVELOPER / DEMO account only (account-d.docusign.com, demo.docusign.net)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# RSA private key (PEM). Newlines may be written as \n on one line.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_CONNECT_URL=
DOCUSIGN_CONNECT_HMAC_KEY=
# Optional: where the agreement template is fetched from (defaults to <app origin>/templates/...)
AGREEMENT_TEMPLATE_URL=

# iVeri Lite card payments (Full Redirect). Server-side secrets: set them on the edge functions only, never
# in a VITE_ variable, never committed, never logged. TEST environment only: any other IVERI_ENVIRONMENT
# turns card payments off. No Live App ID: Live/Production needs Alex's own yes (OI-TBC-33).
IVERI_ENVIRONMENT=test
# TEST App ID from iVeri BackOffice (portal.host.iveri.com). Card payments are off until it is set.
IVERI_APPLICATION_ID=
# Only if "Enable Token Verification" is on in BackOffice; adds Lite_Transaction_Token to the form.
IVERI_SHARED_SECRET=
# Optional overrides; default to the iVeri TEST portal.
IVERI_GATEWAY_URL=
IVERI_AUTHORISE_INFO_URL=
# Where iVeri sends the browser back; defaults to <SUPABASE_URL>/functions/v1/iveri-return.
IVERI_RETURN_URL=

PORTAL_URL=https://lakecity.standledger.io
# Public origin of this app; the ONLY source of offer links in emails (never taken from the request).
APP_URL=

# Local dev only: lets lead-api's simulate-payment stand in for AuthoriseInfo on the caller's own attempt
# (card status of your choice). Never true in a shared or production environment.
ALLOW_DEV_SIMULATIONS=false

# Emails: automated sends are approved, but the transport is the preview outbox until a provider is
# chosen and its adapter implemented (OI-TBC-20). Live sending needs ALL of these AND that adapter.
EMAILS_LIVE=false
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
