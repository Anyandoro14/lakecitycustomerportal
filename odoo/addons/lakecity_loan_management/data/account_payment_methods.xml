<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer receipts (Receive Money). Lines auto-created on bank/cash journals like Manual. -->
        <record id="payment_method_lakecity_transfer_inbound" model="account.payment.method">
            <field name="name">Transfer</field>
            <field name="code">lakecity_transfer</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_lakecity_cash_inbound" model="account.payment.method">
            <field name="name">Cash</field>
            <field name="code">lakecity_cash</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_lakecity_ecocash_inbound" model="account.payment.method">
            <field name="name">EcoCash</field>
            <field name="code">lakecity_ecocash</field>
            <field name="payment_type">inbound</field>
        </record>
        <record id="payment_method_lakecity_kuva_inbound" model="account.payment.method">
            <field name="name">Kuva</field>
            <field name="code">lakecity_kuva</field>
            <field name="payment_type">inbound</field>
        </record>

        <!-- Vendor payments (Send Money), same channels for symmetry. -->
        <record id="payment_method_lakecity_transfer_outbound" model="account.payment.method">
            <field name="name">Transfer</field>
            <field name="code">lakecity_transfer_out</field>
            <field name="payment_type">outbound</field>
        </record>
        <record id="payment_method_lakecity_cash_outbound" model="account.payment.method">
            <field name="name">Cash</field>
            <field name="code">lakecity_cash_out</field>
            <field name="payment_type">outbound</field>
        </record>
        <record id="payment_method_lakecity_ecocash_outbound" model="account.payment.method">
            <field name="name">EcoCash</field>
            <field name="code">lakecity_ecocash_out</field>
            <field name="payment_type">outbound</field>
        </record>
        <record id="payment_method_lakecity_kuva_outbound" model="account.payment.method">
            <field name="name">Kuva</field>
            <field name="code">lakecity_kuva_out</field>
            <field name="payment_type">outbound</field>
        </record>
    </data>
</odoo>
