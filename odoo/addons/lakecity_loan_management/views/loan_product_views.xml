<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lakecity_loan_product_tree" model="ir.ui.view">
        <field name="name">lakecity.loan.product.tree</field>
        <field name="model">lakecity.loan.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="term_months"/>
                <field name="annual_rate"/>
                <field name="due_day"/>
                <field name="grace_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lakecity_loan_product_form" model="ir.ui.view">
        <field name="name">lakecity.loan.product.form</field>
        <field name="model">lakecity.loan.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="term_months"/>
                        <field name="annual_rate"/>
                        <field name="due_day"/>
                        <field name="grace_days"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lakecity_loan_product" model="ir.actions.act_window">
        <field name="name">Loan Products</field>
        <field name="res_model">lakecity.loan.product</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
