<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lakecity_loan_payment_tree" model="ir.ui.view">
        <field name="name">lakecity.loan.payment.tree</field>
        <field name="model">lakecity.loan.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="external_uid"/>
                <field name="payment_date"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="stand_number"/>
                <field name="amount"/>
                <field name="source"/>
                <field name="reference"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lakecity_loan_payment_form" model="ir.ui.view">
        <field name="name">lakecity.loan.payment.form</field>
        <field name="model">lakecity.loan.payment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="external_uid"/>
                        <field name="contract_id"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="stand_number" readonly="1"/>
                        <field name="payment_date"/>
                        <field name="amount"/>
                        <field name="source"/>
                        <field name="reference"/>
                        <field name="state"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lakecity_loan_payment" model="ir.actions.act_window">
        <field name="name">Loan Payments</field>
        <field name="res_model">lakecity.loan.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
