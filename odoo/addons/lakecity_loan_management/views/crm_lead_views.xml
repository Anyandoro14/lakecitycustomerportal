<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_lakecity" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.lakecity</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Lakecity BNPL" name="lakecity_bnpl">
                    <field name="lakecity_stand_number"/>
                    <field name="lakecity_contract_external_uid"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
