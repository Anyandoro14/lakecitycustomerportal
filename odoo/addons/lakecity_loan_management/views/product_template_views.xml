<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_template_form_lakecity_stand" model="ir.ui.view">
    <field name="name">product.template.form.inherit.lakecity.stand</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="lakecity_stand_number"/>
        <field name="lakecity_stand_phase_id"/>
        <field name="lakecity_stand_total_cost"/>
      </xpath>
      <xpath expr="//field[@name='list_price']" position="after">
        <field name="lakecity_stand_area_sqm"/>
        <field name="lakecity_stand_cost_per_sqm"/>
        <field name="lakecity_stand_cost_id" groups="lakecity_loan_management.group_lakecity_loan_manager"/>
      </xpath>
    </field>
  </record>
</odoo>
