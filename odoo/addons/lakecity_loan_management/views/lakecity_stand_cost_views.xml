<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lakecity_stand_phase_tree" model="ir.ui.view">
        <field name="name">lakecity.stand.phase.tree</field>
        <field name="model">lakecity.stand.phase</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="stand_cost_count"/>
            </list>
        </field>
    </record>

    <record id="view_lakecity_stand_phase_form" model="ir.ui.view">
        <field name="name">lakecity.stand.phase.form</field>
        <field name="model">lakecity.stand.phase</field>
        <field name="arch" type="xml">
            <form string="Project phase">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                        <field name="stand_cost_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lakecity_stand_phase" model="ir.actions.act_window">
        <field name="name">Project phases</field>
        <field name="res_model">lakecity.stand.phase</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_lakecity_stand_cost_tree" model="ir.ui.view">
        <field name="name">lakecity.stand.cost.tree</field>
        <field name="model">lakecity.stand.cost</field>
        <field name="arch" type="xml">
            <list>
                <field name="stand_number"/>
                <field name="phase_id"/>
                <field name="area_sqm"/>
                <field name="cost_per_sqm"/>
                <field name="total_cost"/>
                <field name="product_tmpl_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_lakecity_stand_cost_form" model="ir.ui.view">
        <field name="name">lakecity.stand.cost.form</field>
        <field name="model">lakecity.stand.cost</field>
        <field name="arch" type="xml">
            <form string="Stand cost">
                <sheet>
                    <group>
                        <group>
                            <field name="stand_number"/>
                            <field name="phase_id"/>
                            <field name="area_sqm"/>
                        </group>
                        <group>
                            <field name="cost_per_sqm"/>
                            <field name="total_cost"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="product_tmpl_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lakecity_stand_cost_search" model="ir.ui.view">
        <field name="name">lakecity.stand.cost.search</field>
        <field name="model">lakecity.stand.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="stand_number"/>
                <field name="phase_id"/>
                <filter string="By phase" name="group_phase" context="{'group_by': 'phase_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_lakecity_stand_cost" model="ir.actions.act_window">
        <field name="name">Stand cost master</field>
        <field name="res_model">lakecity.stand.cost</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_phase': 0}</field>
    </record>

    <record id="view_account_move_line_lakecity_phase_pivot" model="ir.ui.view">
        <field name="name">account.move.line.lakecity.phase.pivot</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Stand sales by phase">
                <field name="lakecity_stand_phase_id" type="row"/>
                <field name="account_id" type="row"/>
                <field name="lakecity_stand_move_purpose" type="col"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_account_move_line_lakecity_phase_search" model="ir.ui.view">
        <field name="name">account.move.line.lakecity.phase.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="lakecity_stand_phase_id"/>
                <field name="lakecity_loan_contract_id"/>
                <field name="account_id"/>
                <filter string="Stand sales only" name="stand_sales"
                    domain="[('move_id.lakecity_loan_contract_id', '!=', False)]"/>
                <filter string="Revenue accounts" name="revenue"
                    domain="[('account_id.code', '=like', '401%')]"/>
                <filter string="Cost of sales" name="cos"
                    domain="[('account_id.code', '=like', '501%')]"/>
                <filter string="By phase" name="group_phase" context="{'group_by': 'lakecity_stand_phase_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_lakecity_stand_sales_by_phase" model="ir.actions.act_window">
        <field name="name">Stand sales by phase</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_account_move_line_lakecity_phase_pivot"/>
        <field name="search_view_id" ref="view_account_move_line_lakecity_phase_search"/>
        <field name="domain">[('move_id.lakecity_loan_contract_id', '!=', False)]</field>
        <field name="context">{'search_default_stand_sales': 1}</field>
    </record>

    <menuitem
        id="menu_lakecity_stand_cost"
        name="Stand cost master"
        parent="menu_lakecity_loan_root"
        action="action_lakecity_stand_cost"
        sequence="50"
        groups="lakecity_loan_management.group_lakecity_loan_manager"/>

    <menuitem
        id="menu_lakecity_stand_phase"
        name="Project phases"
        parent="menu_lakecity_loan_root"
        action="action_lakecity_stand_phase"
        sequence="51"
        groups="lakecity_loan_management.group_lakecity_loan_manager"/>

    <menuitem
        id="menu_lakecity_stand_sales_by_phase"
        name="Stand sales by phase"
        parent="account.menu_finance_reports"
        action="action_lakecity_stand_sales_by_phase"
        sequence="45"
        groups="account.group_account_readonly"/>
</odoo>
