<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_lakecity_bnpl_gl" model="ir.ui.view">
        <field name="name">res.company.form.inherit.lakecity.bnpl.gl</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Lakecity BNPL" groups="account.group_account_manager">
                    <group string="Loan balances on GL">
                        <field name="lakecity_bnpl_future_receivable_gl_enabled"/>
                        <field name="lakecity_bnpl_journal_id"/>
                        <field name="lakecity_bnpl_installment_clearing_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
