<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lakecity_bank_payment_backfill_wizard" model="ir.ui.view">
        <field name="name">lakecity.bank.payment.backfill.wizard.form</field>
        <field name="model">lakecity.bank.payment.backfill.wizard</field>
        <field name="arch" type="xml">
            <form string="Backfill bank payments from BNPL receipts">
                <group>
                    <field name="company_id"/>
                    <group colspan="2" invisible="not result_message">
                        <field name="result_message" colspan="2" nolabel="1"/>
                    </group>
                </group>
                <p class="text-muted mb-2">
                    Company must have ‘Post bank payment per BNPL receipt’ enabled with a BNPL collections
                    journal. Each eligible posted BNPL line gets one inbound customer payment.
                </p>
                <footer>
                    <button name="action_preview" string="Preview" type="object" class="btn-secondary"/>
                    <button name="action_apply"
                            string="Create accounting payments"
                            type="object"
                            class="btn-primary"
                            confirm="This creates one inbound customer payment for each posted BNPL line that still has none. Continue?"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lakecity_bank_payment_backfill_wizard" model="ir.actions.act_window">
        <field name="name">Backfill bank payments</field>
        <field name="res_model">lakecity.bank.payment.backfill.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
