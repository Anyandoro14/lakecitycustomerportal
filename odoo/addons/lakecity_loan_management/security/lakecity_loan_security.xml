<?xml version="1.0" encoding="utf-8"?>
<!--
  Odoo 19: res.groups no longer has category_id. Classification uses
  res.groups.privilege (still linked to ir.module.category) and privilege_id.
-->
<odoo>
    <!-- Avoid ref to base.module_category_accounting: that xml id ships with Accounting
         and may be missing until `account` is installed. Keeps installs working on CRM-only DBs.
    -->
    <record id="module_category_lakecity_loans" model="ir.module.category">
        <field name="name">Lakecity Loans</field>
        <field name="description">BNPL loan contracts for Lakecity / Stand Ledger.</field>
        <field name="sequence">22</field>
    </record>

    <record id="res_groups_privilege_lakecity_loans" model="res.groups.privilege">
        <field name="name">Lakecity Loans</field>
        <field name="placeholder">Loan access</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_lakecity_loans"/>
    </record>

    <record id="group_lakecity_loan_user" model="res.groups">
        <field name="name">Lakecity Loan User</field>
        <field name="privilege_id" ref="res_groups_privilege_lakecity_loans"/>
    </record>

    <record id="group_lakecity_loan_manager" model="res.groups">
        <field name="name">Lakecity Loan Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lakecity_loans"/>
        <field name="implied_ids" eval="[(4, ref('group_lakecity_loan_user'))]"/>
        <!-- Bootstrap: Settings admins see BNPL menus without manual group assignment -->
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
