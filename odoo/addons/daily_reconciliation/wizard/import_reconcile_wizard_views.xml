<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_reconciliation_import_wizard" model="ir.ui.view">
        <field name="name">daily.reconciliation.import.wizard.form</field>
        <field name="model">daily.reconciliation.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import today's reconcile">
                <group>
                    <field name="reconcile_date"/>
                    <field name="source"/>
                    <field name="data_file" filename="filename" invisible="source != 'upload'"/>
                    <field name="filename" invisible="1"/>
                    <field name="paste_json" invisible="source != 'paste'"
                              placeholder='[{"severity":"critical","stand":"A12","issue":"amount_mismatch",...}]'/>
                </group>
                <p class="text-muted mb-2">
                    Feed the queue from <code>scripts/daily-bnpl-three-way-reconcile.mjs</code>
                    output (<code>bnpl-reconcile-YYYY-MM-DD.csv</code> or JSON issue list).
                    Does not re-run the compare engine — uses the same issue codes as the
                    operator runbook (pre_cutoff_hit_bank, missing_receipt_unposted, etc.).
                    Or POST to <code>/lakecity/api/v1/daily-reconciliation/ingest</code>.
                </p>
                <group invisible="not result_message">
                    <field name="result_message" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import" string="Import into queue" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_reconciliation_import_wizard" model="ir.actions.act_window">
        <field name="name">Import today's reconcile</field>
        <field name="res_model">daily.reconciliation.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
