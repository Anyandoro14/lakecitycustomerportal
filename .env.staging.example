# Staging Lovable Cloud connection (copy to .env.staging.local — never commit real values).
# Used by: vite when started with `npm run dev:staging` (you'll add that script if needed).

VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Optional: override the default tenant slug for staging
VITE_DEFAULT_TENANT_SLUG=lakecity

# Standledger Odoo Staging (partner email sync, BNPL API scripts)
# Copy these into .env for scripts/sync-partner-emails-from-csv.mjs — Staging first.
# See docs/partner-email-sync.md
ODOO_ORIGIN=https://lakecity-standledger-staging-38585394.dev.odoo.com
LAKECITY_LOAN_API_TOKEN=paste_staging_lakecity_loan.api_token_here
# STAND_EMAIL_CSV_PATH=exports/stand_email_updates.csv
